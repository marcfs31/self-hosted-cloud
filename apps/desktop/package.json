{
  "name": "@cloud/desktop",
  "version": "0.16.0",
  "private": true,
  "productName": "Cloud",
  "description": "Menu-bar app that keeps a folder in sync with a Self-Hosted Cloud server.",
  "type": "module",
  "main": "dist/main/main.js",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p src/renderer/tsconfig.json",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build && electron . --smoke",
    "icons": "node packaging/make-icons.ts",
    "package": "pnpm build && node packaging/package.ts",
    "typecheck": "tsc --noEmit && tsc -p src/renderer/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloud/shared": "workspace:*",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@cloud/api": "workspace:*",
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0",
    "vitest": "^5.0.4"
  }
}
