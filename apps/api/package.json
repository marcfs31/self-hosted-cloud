{
  "name": "@cloud/api",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATA_DIR=../../data PUBLIC_ORIGIN=http://localhost:3000 SECRET_KEY=${SECRET_KEY:-$(printf 'dev-only-secret-key-not-for-prod' | base64)} tsx watch --conditions=@cloud/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "backup-db": "node dist/backup-db.js"
  },
  "dependencies": {
    "@cloud/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
