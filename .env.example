# API (apps/api)
PORT=4000

# REQUIRED. Seals two-step-verification secrets (AES-256-GCM) before they reach the database.
# 32 random bytes, base64. Generate one with:
#   openssl rand -base64 32
# `pnpm dev` falls back to a fixed development key when this is unset; never use that one for
# real data. Keep this value OUT of the /data backups and store it somewhere safe (a password
# manager): without it nobody's two-step verification works. An admin can then reset it per user.
SECRET_KEY=

# Web (apps/web) — where Next.js forwards /api/* when Caddy is not in front (dev).
API_ORIGIN=http://localhost:4000
