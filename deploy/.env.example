# Copy to deploy/.env (on the Pi: /opt/cloud/.env). Not secret, but keep a copy somewhere
# off the Pi: disaster recovery needs to know which version and domain to start.

# Public hostname Caddy serves. On the Pi this is the Tailscale name, e.g.
#   cloud.tail1234.ts.net
# For a local smoke test use: localhost
CLOUD_DOMAIN=

# Image tag to run: the release version without the leading "v" (tag v0.2.0 -> 0.2.0).
# Updating = change this, then `docker compose pull && docker compose up -d`.
CLOUD_VERSION=

# Registry path without the -api / -web suffix, lowercase:
#   ghcr.io/<github-owner>/self-hosted-cloud
# Local build only: any name, e.g. `cloud`.
CLOUD_IMAGE_PREFIX=

# Optional. Address Caddy publishes 80/443 on. Default is every interface. Set it to the
# Pi's Tailscale IPv4 (`tailscale ip -4`) to be tailnet-only. See deploy/pi-setup.md.
# CLOUD_BIND_IP=

# Optional. Host directory with cert.pem + key.pem, mounted read-only into Caddy at /tls.
# cloud-tls.service (`tailscale cert`) writes it. Default /opt/cloud/tls.
# CLOUD_TLS_DIR=
