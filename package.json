{
  "name": "self-hosted-cloud",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "versions:check": "node scripts/check-versions.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm versions:check",
    "version:set": "node scripts/set-version.ts",
    "e2e": "pnpm --filter @cloud/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
